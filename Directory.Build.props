<Project>
  <PropertyGroup>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);1591</NoWarn>    
    <Authors>Federico Dipuma</Authors>
    <Description>OData query parser and executor for .NET Core</Description>
    <Copyright>(C) 2024 Federico Dipuma</Copyright>
    <PackageProjectUrl>https://github.com/fdipuma/scrima-dotnet</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/fdipuma/scrima-dotnet</RepositoryUrl>
  </PropertyGroup>

  <!-- EF Core and ASP.NET Core packages must match the major version of the target framework -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <EfCoreVersion>10.0.15</EfCoreVersion>
    <AspNetCoreVersion>10.0.15</AspNetCoreVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <EfCoreVersion>11.0.0</EfCoreVersion>
    <AspNetCoreVersion>11.0.0</AspNetCoreVersion>
  </PropertyGroup>
</Project>